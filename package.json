{
  "name": "grid-table-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./packages/core dev",
    "dev:vue": "pnpm --filter ./apps/vue-demo dev",
    "dev:react": "pnpm --filter ./apps/react-demo dev",
    "build:core": "pnpm --filter ./packages/core build",
    "build:adapters": "pnpm --filter ./packages/adapters build",
    "build": "pnpm build:core && pnpm build:adapters",
    "setup": "pnpm install && pnpm build"
  },
  "devDependencies": {
    "sass": "^1.89.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}